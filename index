<body>

<!-- HEADER -->
<header>
  <div class="header-inner">
    <a class="logo header-logo-link" href="#" aria-label="MatematicaOro"><img src="assets/Logo/Logo_sfondo_blu.png" alt="MatematicaOro"></a>
    <nav>
      <a class="nav-featured" href="#fumetti">📖 Fumetti</a>
      <a href="#lezioni">💡 Lezioni</a>
      <a href="#teoria">Teoria</a>
      <a href="#esercizi">Esercizi</a>
      <a href="#schemi">Schemi</a>
    </nav>
  </div>
</header>

<!-- HERO -->
<div class="hero">
  <h1><span class="brand-blue">Matematica</span><span class="brand-gold">Oro</span></h1>
  <p>Fumetti, Lezioni, Teoria, Esercizi e Schemi per la scuola secondaria</p>
</div>

<main>


  <!-- FUMETTI (sezione principale) -->
  <section id="fumetti" class="section-comics">
    <span class="featured-tag">✨ Impara con le storie</span>
    <div class="section-header">
      <div class="section-icon">📖</div>
      <h2>Fumetti didattici</h2>
    </div>

    <p class="fumetti-intro">
