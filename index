<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MatematicaOro</title>
  <link rel="manifest" href="manifest-site.json">
  <link rel="apple-touch-icon" href="MO_logo.png">
<style>
    :root {
      --blu:       #1a3a5c;
      --blu-mid:   #2d5f8a;
      --blu-soft:  #e8f0f8;
      --accento:   #d4882b;
      --accento-light: #fdf3e3;
      --testo:     #2c2c2c;
      --testo-soft:#5a5a6a;
      --bg:        #f7f8fc;
      --bianco:    #ffffff;
      --bordo:     #dde3ed;
      --evidenza:       #1f7ae0;
      --evidenza-dark:  #145bab;
      --evidenza-light: #e4f1ff;
      --evidenza-bordo: #b8d8f7;
      --raggio:    10px;
      --ombra:     0 2px 12px rgba(26,58,92,0.09);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--testo);
      line-height: 1.6;
    }

    /* ── HEADER ── */
    header {
      background: linear-gradient(135deg, #2d5f8a 0%, #1a3a5c 100%);
      color: white;
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 16px rgba(26,58,92,0.18);
    }
    .header-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 14px 32px;
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .logo {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: .02em;
      color: #fff;
      text-decoration: none;
      opacity: .95;
      flex-shrink: 0;
    }
    .logo span { color: #f0c06e; }
    nav { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; }
    nav a {
      color: rgba(255,255,255,.82);
      text-decoration: none;
      font-size: .88rem;
      font-weight: 500;
      padding: 6px 14px;
      border-radius: 20px;
      transition: background .2s, color .2s;
    }
    nav a:hover {
      background: rgba(255,255,255,.15);
      color: #fff;
    }
    nav a.nav-featured {
      background: var(--evidenza);
      color: #fff;
      font-weight: 600;
    }
    nav a.nav-featured:hover { background: var(--evidenza-dark); }


    /* ── HERO ── */
    .hero {
      background: linear-gradient(160deg, #e8f0f8 0%, #f7f8fc 60%);
      border-bottom: 1px solid var(--bordo);
      padding: 56px 32px 48px;
      text-align: center;
    }
    .hero h1 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(2rem, 5vw, 2.9rem);
      color: var(--blu);
      font-weight: 600;
      margin-bottom: 12px;
    }
    .hero p {
      color: var(--testo-soft);
      font-size: 1.08rem;
      max-width: 560px;
      margin: 0 auto;
    }

    /* ── MAIN ── */
    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 48px 24px 64px;
      display: flex;
      flex-direction: column;
      gap: 52px;
    }

    /* ── SECTION TITLE ── */
    .section-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
      padding-bottom: 14px;
      border-bottom: 2px solid var(--bordo);
    }
    .section-icon {
      font-size: 1.7rem;
      background: var(--blu-soft);
      width: 48px; height: 48px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .section-header h2 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.6rem;
      color: var(--blu);
      font-weight: 600;
    }


    /* ── FUMETTI: sezione principale ── */
    .section-comics {
      background: linear-gradient(160deg, #f7f1ed 0%, #fdfbf9 100%);
      border: 1px solid #dfd0c7;
      border-radius: 18px;
      padding: 32px 28px 36px;
      box-shadow: 0 6px 26px rgba(120,88,70,0.10);
      position: relative;
    }
    .section-comics .featured-tag {
      background: #a8755b;
    }
    .section-comics .section-header {
      border-bottom: 2px solid #dfd0c7;
    }
    .section-comics .section-icon {
      background: #a8755b;
      color: #fff;
      box-shadow: 0 3px 10px rgba(120,88,70,0.18);
    }
    .section-comics .section-header h2 {
      color: #725143;
    }
    .section-comics details {
      border-color: #dfd0c7;
    }
    .section-comics summary {
      color: #725143;
    }
    .section-comics summary:hover {
      background: #f7f1ed;
    }
    .section-comics summary::after {
      color: #a8755b;
    }
    .section-comics .badge {
      background: #f3e9e3;
      color: #725143;
    }
    .fumetti-empty {
      padding: 14px 20px 18px;
      color: var(--testo-soft);
      font-size: .9rem;
      font-style: italic;
    }


    .fumetti-intro {
      color: var(--testo-soft);
      font-size: .96rem;
      margin: -4px 2px 22px;
      max-width: 760px;
    }

    .collane-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .collana-card {
      background: rgba(255,255,255,.82);
      border: 1px solid #dfd0c7;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 2px 10px rgba(80,60,50,.06);
    }

    .collana-card h3 {
      font-family: Georgia, 'Times New Roman', serif;
      color: #725143;
      font-size: 1.22rem;
      margin: 3px 0 7px;
    }

    .collana-card p {
      color: var(--testo-soft);
      font-size: .9rem;
      line-height: 1.55;
      margin-bottom: 14px;
    }

    .collana-kicker {
      color: #8d6b5a;
      text-transform: uppercase;
      letter-spacing: .07em;
      font-size: .68rem;
      font-weight: 700;
    }

    .collana-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 14px;
    }

    .collana-meta span {
      background: #f3e9e3;
      color: #725143;
      border-radius: 20px;
      padding: 3px 9px;
      font-size: .72rem;
      font-weight: 600;
    }

    .collana-soon {
      display: inline-block;
      color: #8d6b5a;
      font-size: .78rem;
      font-weight: 600;
    }

    .collana-placeholder {
      grid-column: 1 / -1;
      background: rgba(255,255,255,.48);
      border-style: dashed;
    }

    @media (max-width: 700px) {
      .collane-grid { grid-template-columns: 1fr; }
      .collana-placeholder { grid-column: auto; }
    }

    /* ── SEZIONE IN EVIDENZA (Lezioni) ── */
    .section-featured {
      background: linear-gradient(160deg, var(--evidenza-light) 0%, #fbfdff 100%);
      border: 1px solid var(--evidenza-bordo);
      border-radius: 18px;
      padding: 32px 28px 36px;
      box-shadow: 0 6px 28px rgba(31,122,224,0.14);
      position: relative;
    }
    .featured-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--evidenza);
      color: #fff;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
      padding: 5px 12px;
      border-radius: 20px;
      margin-bottom: 14px;
    }
    .section-featured .section-header {
      border-bottom: 2px solid var(--evidenza-bordo);
    }
    .section-featured .section-icon {
      background: var(--evidenza);
      color: #fff;
      box-shadow: 0 3px 10px rgba(31,122,224,0.35);
    }
    .section-featured .section-header h2 {
      color: var(--evidenza-dark);
    }
    .section-featured details {
      border-color: var(--evidenza-bordo);
    }
    .section-featured summary {
      color: var(--evidenza-dark);
    }
    .section-featured summary:hover { background: var(--evidenza-light); }
    .section-featured summary::after { color: var(--evidenza); }
    .section-featured .badge {
      background: var(--evidenza-light);
      color: var(--evidenza-dark);
    }

    /* ── ACCORDION (Teoria / Esercizi / Schemi) ── */
    .accordion { display: flex; flex-direction: column; gap: 8px; }

    details {
      background: var(--bianco);
      border: 1px solid var(--bordo);
      border-radius: var(--raggio);
      overflow: hidden;
      box-shadow: var(--ombra);
      transition: box-shadow .2s;
    }
    details[open] { box-shadow: 0 4px 20px rgba(26,58,92,0.12); }

    summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      cursor: pointer;
      font-weight: 600;
      color: var(--blu);
      font-size: .97rem;
      list-style: none;
      user-select: none;
      transition: background .15s;
    }
    summary:hover { background: var(--blu-soft); }
    summary::after {
      content: '▾';
      font-size: .85rem;
      color: var(--blu-mid);
      transition: transform .25s;
    }
    details[open] summary::after { transform: rotate(180deg); }

    .badge {
      background: var(--blu-soft);
      color: var(--blu-mid);
      font-size: .75rem;
      font-weight: 600;
      padding: 2px 9px;
      border-radius: 20px;
      margin-left: auto;
      margin-right: 10px;
    }

    .file-list {
      padding: 8px 20px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .file-list a {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--blu-mid);
      text-decoration: none;
      font-size: .92rem;
      padding: 7px 10px;
      border-radius: 7px;
      transition: background .15s, color .15s;
    }
    .file-list a:hover {
      background: var(--blu-soft);
      color: var(--blu);
    }
    .file-list a span.icon { font-size: 1rem; }

    /* ── LEZIONI ── */
    .lezione-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 10px;
      border-radius: 7px;
      transition: background .15s;
    }
    .lezione-row:hover { background: var(--blu-soft); }

    .lezione-info { flex: 1; min-width: 0; }
    .lezione-info strong {
      display: block;
      font-size: .95rem;
      color: var(--blu);
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lezione-info span {
      font-size: .82rem;
      color: var(--testo-soft);
    }

    .btn-inizia {
      flex-shrink: 0;
      display: inline-block;
      background: var(--accento);
      color: #fff;
      font-size: .8rem;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 20px;
      text-decoration: none;
      transition: background .18s, transform .15s;
      white-space: nowrap;
    }
    .btn-inizia:hover { background: #b8711f; transform: scale(1.04); }

    /* ── FOOTER ── */
    footer {
      background: #e8f0f8;
      border-top: 1px solid #cddaec;
      color: var(--testo-soft);
      padding: 36px 32px;
      text-align: center;
    }
    .footer-inner {
      max-width: 700px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
    }
    .footer-logo {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 1.1rem;
      color: var(--blu);
      font-weight: 600;
    }
    .footer-bio {
      font-size: .9rem;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-bio span {
      background: var(--bianco);
      border: 1px solid var(--bordo);
      padding: 3px 12px;
      border-radius: 20px;
      font-size: .8rem;
    }
    .footer-copy {
      font-size: .8rem;
      color: #8a9ab5;
      margin-top: 6px;
    }

    @media (max-width: 600px) {
      .header-inner { padding: 10px 14px; gap: 10px; }
      .logo { font-size: 1.05rem; }

      /* nav diventa una striscia scorrevole orizzontale invece di andare a capo;
         resta sulla stessa riga di logo e icona cerca, che non scorrono via */
      nav {
        flex: 1;
        min-width: 0;
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        gap: 4px;
        scrollbar-width: none;
      }
      nav::-webkit-scrollbar { display: none; }
      nav a { flex-shrink: 0; font-size: .8rem; padding: 6px 10px; }

      .hero { padding: 32px 20px 28px; }
      .hero h1 { font-size: clamp(1.7rem, 8vw, 2.2rem); }
      .hero p { font-size: .95rem; }

      main { padding: 28px 14px 40px; gap: 40px; }

      .section-header { gap: 10px; margin-bottom: 18px; padding-bottom: 10px; }
      .section-icon { width: 40px; height: 40px; font-size: 1.4rem; border-radius: 10px; }
      .section-header h2 { font-size: 1.3rem; }

      summary { padding: 13px 14px; font-size: .92rem; }
      .badge { font-size: .7rem; padding: 2px 8px; margin-right: 6px; }
      .file-list { padding: 6px 14px 14px; }
      .file-list a { font-size: .9rem; padding: 9px 8px; white-space: normal; }

      /* le righe delle lezioni si impilano: titolo/testo sopra, pulsante sotto,
         così restano leggibili e il pulsante resta ben tappabile */
      .lezione-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 8px;
      }
      .lezione-info strong { white-space: normal; }
      .btn-inizia { align-self: flex-start; padding: 8px 18px; font-size: .85rem; }

      .footer-bio { gap: 8px; }
      footer { padding: 28px 20px; }
    }

    @media (max-width: 360px) {
      .hero h1 { font-size: 1.55rem; }
      .logo { font-size: 1.1rem; }
    }
  </style>

<style>
